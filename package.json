{
  "name": "claude-codex-usage-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "A local Windows dashboard for Claude Code and Codex usage limits.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron ./desktop/main.js",
    "start:desktop": "electron ./desktop/main.js",
    "postinstall": "node scripts/ensure-electron.js",
    "autostart:desktop": "install-desktop-autostart.bat",
    "autostart:desktop:off": "uninstall-desktop-autostart.bat",
    "setup:claude": "node setup-statusline.js",
    "setup:claude:fanout": "node setup-statusline.js --fanout",
    "test": "node --test",
    "lint": "eslint .",
    "check": "node --check server.js && node --check kimi-usage-snapshot.js && node --check grok-usage-snapshot.js && node --check dashboard.js && node --check phone-display.js && node --check lib/phone-display.js && node --check desktop/main.js && node --check desktop/menu-template.js && node --check desktop/preload.js && node --check desktop/window-bounds.js && node --check setup-statusline.js && node --check statusline-usage.js && node --check statusline-both.js && node --check scripts/ensure-electron.js && node scripts/ensure-electron.js --check && npm run lint && npm test",
    "pack:win": "electron-builder --win portable"
  },
  "keywords": [
    "claude",
    "codex",
    "usage-dashboard",
    "windows",
    "statusline"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@electron/get": {
      "undici": "7.29.0"
    }
  },
  "build": {
    "appId": "com.local.claude-codex-usage-dashboard",
    "productName": "AI Usage Dashboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!.agents{,/**}",
      "!.claude{,/**}",
      "!.codegraph{,/**}",
      "!.codex{,/**}",
      "!.grok{,/**}",
      "!.idea{,/**}",
      "!.kimi-code{,/**}",
      "!.vscode{,/**}",
      "!.workbuddy{,/**}",
      "!archive{,/**}",
      "!config.json",
      "!docs{,/**}",
      "!release{,/**}",
      "!test{,/**}",
      "!*.md",
      "!**/*.bak",
      "!**/*.db*",
      "!**/*.log",
      "!**/*.tmp"
    ],
    "asarUnpack": [
      "server.js",
      "lib/**/*",
      "dashboard.html",
      "dashboard.css",
      "dashboard.js",
      "phone-display.html",
      "phone-display.css",
      "phone-display.js",
      "phone-pair.css",
      "kimi-usage-snapshot.js",
      "grok-usage-snapshot.js"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "AI-Usage-Dashboard-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "26.15.3",
    "eslint": "10.9.0"
  }
}
